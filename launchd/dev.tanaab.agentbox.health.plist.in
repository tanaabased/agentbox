<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>__AGENTBOX_HEALTH_LABEL__</string>

    <key>ProgramArguments</key>
    <array>
      <string>__AGENTBOX_HEALTH_SCRIPT_PATH__</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__AGENTBOX_HEALTH_STDOUT_LOG__</string>

    <key>StandardErrorPath</key>
    <string>__AGENTBOX_HEALTH_STDERR_LOG__</string>
  </dict>
</plist>
