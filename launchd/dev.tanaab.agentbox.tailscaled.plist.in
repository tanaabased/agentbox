<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>__AGENTBOX_TAILSCALED_LABEL__</string>

    <key>ProgramArguments</key>
    <array>
      <string>__AGENTBOX_TAILSCALED_BIN__</string>
    </array>

    <key>UserName</key>
    <string>root</string>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__AGENTBOX_TAILSCALED_STDOUT_LOG__</string>

    <key>StandardErrorPath</key>
    <string>__AGENTBOX_TAILSCALED_STDERR_LOG__</string>
  </dict>
</plist>
