#!/bin/bash
set -euo pipefail

printf "debug prepared effective brewfile at /var/folders/fake/brewfile-effective.test\n"
printf "bootbox\n" >> "${AGENTBOX_FAKE_SUDO_EVENT_LOG}"
printf "bootbox_external_sudo=%s\n" "${BOOTBOX_EXTERNAL_SUDO:-missing}" > "${AGENTBOX_FAKE_SUDO_STATE_DIR}/bootbox.log"

if [[ "${AGENTBOX_FAKE_SUDO_CASE:-}" == "interactive-bootbox-sudo" ]]; then
  "${SUDO_BIN}" -v
fi
