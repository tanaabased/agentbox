#!/bin/bash
set -euo pipefail

line="sudo"
for arg in "$@"; do
  printf -v quoted "%q" "${arg}"
  line="${line} ${quoted}"
done
printf "%s\n" "${line}" >> "${AGENTBOX_FAKE_SUDO_LOG}"
printf "%s\n" "${line}" >> "${AGENTBOX_FAKE_SUDO_EVENT_LOG}"

is_validation="0"
if [[ "${1:-}" == "-n" && "${2:-}" == "-v" ]]; then
  is_validation="1"
fi

case "${AGENTBOX_FAKE_SUDO_CASE:-}" in
  stale-keepalive)
    if [[ "${is_validation}" == "1" && "${PPID}" != "${AGENTBOX_FAKE_SUDO_MAIN_PID}" && ! -e "${AGENTBOX_FAKE_SUDO_STATE_DIR}/keepalive-failed" ]]; then
      : > "${AGENTBOX_FAKE_SUDO_STATE_DIR}/keepalive-failed"
      exit 1
    fi
    ;;
  interactive-recovery)
    if [[ "${1:-}" == "-v" ]]; then
      rm -f "${AGENTBOX_FAKE_SUDO_STATE_DIR}/authorization-invalid"
    elif [[ "${is_validation}" == "1" && "${PPID}" != "${AGENTBOX_FAKE_SUDO_MAIN_PID}" && ! -e "${AGENTBOX_FAKE_SUDO_STATE_DIR}/keepalive-failed-1" ]]; then
      : > "${AGENTBOX_FAKE_SUDO_STATE_DIR}/keepalive-failed-1"
      : > "${AGENTBOX_FAKE_SUDO_STATE_DIR}/authorization-invalid"
      exit 1
    elif [[ "${is_validation}" == "1" && "${PPID}" != "${AGENTBOX_FAKE_SUDO_MAIN_PID}" && ! -e "${AGENTBOX_FAKE_SUDO_STATE_DIR}/keepalive-failed-2" ]]; then
      : > "${AGENTBOX_FAKE_SUDO_STATE_DIR}/keepalive-failed-2"
      : > "${AGENTBOX_FAKE_SUDO_STATE_DIR}/authorization-invalid"
      exit 1
    elif [[ "${is_validation}" == "1" && -e "${AGENTBOX_FAKE_SUDO_STATE_DIR}/authorization-invalid" ]]; then
      exit 1
    fi
    ;;
  ci-invalid)
    if [[ "${is_validation}" == "1" ]]; then
      exit 1
    fi
    ;;
esac

exit 0
