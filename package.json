{
  "name": "@tanaab/agentbox",
  "description": "Tanaab based agentbox provisioning.",
  "version": "1.0.0-beta.9",
  "author": "Mike Pirog @pirog",
  "license": "MIT",
  "repository": "https://github.com/tanaabased/agentbox",
  "bugs": "https://github.com/tanaabased/agentbox/issues",
  "homepage": "https://github.com/tanaabased/agentbox",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0 <1.4.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@tanaab/codex-tools": "^1.0.0-beta.1",
    "@eslint/js": "^10.0.1",
    "@lando/leia": "2.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^17.12.0",
    "mocha": "^12.0.2",
    "prettier": "^3.9.8",
    "shellcheck": "^4.1.0"
  },
  "scripts": {
    "build": "bun ./scripts/build-dist.js",
    "codex:check": "codex-tools cache check --repo-root .",
    "codex:sync": "codex-tools cache sync --repo-root .",
    "format:check": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "leia": "bun ./node_modules/.bin/leia",
    "lint": "bun run lint:eslint && bun run format:check && bun run lint:shellcheck",
    "lint:eslint": "eslint .",
    "lint:shellcheck": "shellcheck *.sh bin/*.sh libexec/*.sh scripts/*.sh",
    "test": "bun run test:unit",
    "test:unit": "mocha \"test/**/*.spec.js\""
  },
  "codexTools": {
    "managedPaths": [
      ".codex-plugin",
      ".mcp.json",
      "AGENTS.md",
      "ADVANCED.md",
      "CODEX.md",
      "README.md",
      "assets",
      "lib",
      "package.json",
      "scripts/check-plugin-runtime.sh",
      "skills"
    ],
    "missingTarget": "require-installed",
    "absentCheck": "neutral"
  }
}
