{
  "name": "@tanaabased/agentbox",
  "description": "Mac mini AgentBox base provisioning scaffolding.",
  "version": "0.0.0",
  "author": "Mike Pirog @pirog",
  "license": "MIT",
  "repository": "https://github.com/tanaabased/agentbox",
  "bugs": "https://github.com/tanaabased/agentbox/issues",
  "homepage": "https://github.com/tanaabased/agentbox",
  "packageManager": "bun@1.3.4",
  "engines": {
    "bun": ">=1.3.0 <1.4.0"
  },
  "private": true,
  "type": "module",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "shellcheck": "^4.1.0"
  },
  "scripts": {
    "format:check": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "lint": "bun run lint:eslint && bun run format:check && bun run lint:shellcheck",
    "lint:eslint": "eslint .",
    "lint:shellcheck": "shellcheck boot.sh"
  }
